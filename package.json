{
  "name": "topical-mcp",
  "version": "0.4.0",
  "description": "A local-first Markdown topic store exposed through MCP.",
  "type": "module",
  "bin": {
    "topical": "./src/server.js",
    "topical-mcp": "./src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "preui": "node src/runtime-preflight.js && npm run build:ui",
    "ui": "node src/server.js ui",
    "dev:ui": "vite --config ui/vite.config.js",
    "build:ui": "vite build --config ui/vite.config.js",
    "check:ui": "tsc -p ui/tsconfig.json",
    "doctor": "node src/server.js --doctor",
    "preflight": "node src/runtime-preflight.js",
    "pretest": "node src/runtime-preflight.js && npm run build:ui",
    "test": "node --test test/*.test.js && npm run test:ui",
    "test:server": "node --test test/*.test.js",
    "test:ui": "node test/run-ui-tests.js",
    "pretest:e2e": "node src/runtime-preflight.js && npm run build:ui",
    "test:e2e": "playwright test",
    "pretest:retrieval": "node src/runtime-preflight.js",
    "test:retrieval": "node --test test/search-index.test.js test/benchmark-fixtures.test.js",
    "prebenchmark:v0.4": "node src/runtime-preflight.js",
    "benchmark:v0.4": "node benchmark/run-v0.4-baseline.js",
    "prebenchmark:relevance": "node src/runtime-preflight.js",
    "benchmark:relevance": "node benchmark/run-relevance-evaluation.js",
    "prepack": "npm run build:ui"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.6.2",
    "open": "^10.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "codemirror": "^6.0.2",
    "jsdom": "^27.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "license": "MIT",
  "author": "DanDoDev",
  "homepage": "https://github.com/DanDoDev/topical#readme",
  "bugs": {
    "url": "https://github.com/DanDoDev/topical/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanDoDev/topical.git"
  },
  "keywords": [
    "mcp",
    "markdown",
    "context",
    "notes",
    "agents",
    "local-first"
  ],
  "files": [
    "src",
    "ui-dist",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
